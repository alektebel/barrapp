DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Objectives intake chat (nan.builders, OpenAI-compatible). Set the key and the
# base URL (the root that serves /chat/completions) to enable the live model;
# leave blank to fall back to a static first question.
NAN_API_KEY=
NAN_BASE_URL=
NAN_MODEL=qwen3.8-flash
PORT=8080
BARRA_ROOT=/home/diego/Documents/Development/barrapp

# Primary store for the pipeline evaluation / debugging state (DataStax Astra DB
# Data API). When set, scripts/pipeline_eval.py and barra/tracestore.py write to
# Astra; leave unset to keep the local-on-disk + optional DynamoDB behaviour.
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_KEYSPACE=barra
ASTRA_DB_COLLECTION=pipeline_eval


# Pose backend / learned detector tuning.
# Pin one pose backend (mediapipe or ultralytics), choose YOLO weights, or set
# device for hosts where the default CPU inference is too weak. Tracking is
# opt-in because it can use more memory on constrained hosts.
# BARRA_POSE_BACKEND=ultralytics
# BARRA_YOLO_POSE_WEIGHTS=yolo11m-pose.pt
# BARRA_POSE_DEVICE=cpu
# BARRA_POSE_TRACK=1
# BARRA_MODEL_PATH=models/eval-temp/exercise_model_v5.npz

# Technique study over the rep stills (multimodal, optional). Falls back to
# the text-only report when unset. Uses the nan.builders key by default; set
# BARRA_VISION_* to point it anywhere OpenAI-compatible instead.
BARRA_VISION_MODEL=glm5.3-flash
# BARRA_VISION_BASE_URL=
# BARRA_VISION_API_KEY=
