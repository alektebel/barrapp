<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device by backup or transfer. The session token, the
     device id and the clip copies belong to this install; the measurements
     themselves live on the server and are rebuilt from there on sign-in.
     Mirrors allowBackup="false" for Android 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
