<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only. The debug source set (src/debug/res/xml) replaces
     this file with one that allows cleartext, for a LAN server. Keeping the
     LAN addresses out of here means a release build cannot be pointed at a
     plain-HTTP host by anything, including a mistake in gradle.properties. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
