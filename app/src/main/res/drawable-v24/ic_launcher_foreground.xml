<!--
     The barra figure at lockout, over the bar. Replaces the stock Android
     robot that shipped as the foreground. Drawn inside the 66dp safe zone of
     the 108dp adaptive canvas so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- the bar -->
    <path
        android:pathData="M32,51 L76,51"
        android:strokeWidth="3.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />
    <!-- arms: hands on the bar, shoulders finishing above it -->
    <path
        android:pathData="M44.3,51 L46.5,44.5 L50.2,43.5 M63.7,51 L61.5,44.5 L57.8,43.5"
        android:strokeWidth="3.2"
        android:strokeColor="#FF74B7E0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- shoulders and torso -->
    <path
        android:pathData="M50.2,43.5 L57.8,43.5 M54,43.5 L54,61.9"
        android:strokeWidth="3.2"
        android:strokeColor="#FF74B7E0"
        android:strokeLineCap="round" />
    <!-- legs -->
    <path
        android:pathData="M54,61.9 L55.3,73.8 L55.7,83.5"
        android:strokeWidth="3.2"
        android:strokeColor="#FF74B7E0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- head -->
    <path
        android:pathData="M54,30.5 m-4.9,0 a4.9,4.9 0 1,0 9.8,0 a4.9,4.9 0 1,0 -9.8,0"
        android:fillColor="#FF74B7E0" />
</vector>
